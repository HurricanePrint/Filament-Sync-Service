#!/bin/sh
### BEGIN INIT INFO
# Provides:          filamentsync
# Required-Start:    $local_fs $network
# Required-Stop:     $local_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Filament-Sync-Service Daemon
### END INIT INFO

NAME="filamentsync"
PIDFILE="/var/run/${NAME}.pid"

# Translate WorkingDirectory and ExecStart parameters
WORKING_DIR="/mnt/UDISK/printer_data/config/Filament-Sync-Service"
DAEMON="${WORKING_DIR}/service/sync.sh"
DAEMON_ARGS="k1"

start() {
    echo -n "Starting ${NAME}: "
    if [ ! -d "$WORKING_DIR" ]; then
        echo "FAILED (Directory $WORKING_DIR does not exist)"
        return 1
    fi

    # Start the daemon in the background, set working dir, and save PID
    start-stop-daemon --start --quiet \
        --chdir "$WORKING_DIR" \
        --background \
        --make-pidfile --pidfile "$PIDFILE" \
        --exec "$DAEMON" -- $DAEMON_ARGS
    
    if [ $? -eq 0 ]; then
        echo "OK"
    else
        echo "FAILED"
    fi
}

stop() {
    echo -n "Stopping ${NAME}: "
    if [ -f "$PIDFILE" ]; then
        start-stop-daemon --stop --quiet --pidfile "$PIDFILE"
        rm -f "$PIDFILE"
        echo "OK"
    else
        echo "Not running"
    fi
}

status() {
    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE")
        if kill -0 "$PID" 2>/dev/null; then
            echo "${NAME} is running (PID: $PID)"
            return 0
        fi
    fi
    echo "${NAME} is stopped"
    return 3
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        sleep 1
        start
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0